generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductItem {
  id               Int            @id @default(autoincrement())
  name             String
  url              String
  metaData         Json?
  sex              String
  brand            String
  retailer         String
  price            Float
  frontEmbeddingId Int?
  backEmbeddingId  Int?
  productImages    ProductImage[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ProductImage {
  id            Int      @id @default(autoincrement())
  productItemId Int
  imageUrl      String
  frontFacing   Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clothingItem ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
}
