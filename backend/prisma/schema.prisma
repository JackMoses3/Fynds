generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductItem {
  id               Int            @id @default(autoincrement())
  sex              String
  name             String
  url              String         @unique
  metaData         String
  retailer         String
  price            Float
  frontEmbeddingId BigInt?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  backEmbeddingId  BigInt?
  textEmbeddingId  BigInt?
  brand            String
  category         String?
  subCategory      String?
  productImages    ProductImage[]
}

model ProductImage {
  id            Int         @id @default(autoincrement())
  productItemId Int
  imageUrl      String
  frontFacing   Boolean?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  clothingItem  ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
}
